# Local demo settings. Never commit real tokens, keys, or credentials.
APP_ENV=development
DEBUG=true
HOST=127.0.0.1
AUTH_ENABLED=false
DATABASE_URL=sqlite:///./sentinel.db

# Google Gemini uses the OpenAI-compatible chat-completions API.
# Create a Gemini API key in Google AI Studio; never commit the key.
AI_ENABLED=false
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_ALLOWED_HOSTS=["generativelanguage.googleapis.com"]
AI_MODEL=gemini-3.8-flash
# AI_API_KEY=your-google-ai-studio-gemini-api-key

# Production API authentication uses bearer tokens from your OIDC provider.
# APP_ENV=production
# DEBUG=false
# AUTH_ENABLED=true
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=paypal-sentinel-api
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# OIDC_ALGORITHMS=["RS256"]
# CORS_ORIGINS=["https://app.example.com"]

# Screening is disabled until a licensed provider and its Sentinel adapter
# have been configured. The adapter response must use the documented contract.
SANCTIONS_SCREENING_ENABLED=false
# SANCTIONS_PROVIDER_NAME=Your contracted provider
# SANCTIONS_API_URL=https://your-adapter.example.com/screen
# SANCTIONS_ALLOWED_HOSTS=["your-adapter.example.com"]
# SANCTIONS_API_TOKEN=load-this-from-a-secret-manager

# Payment calls are sandbox-only in this release.
PAYPAL_SANDBOX_ENABLED=false
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
# PAYPAL_CLIENT_ID=load-from-PayPal-developer-dashboard
# PAYPAL_CLIENT_SECRET=load-from-a-secret-manager
# PAYPAL_WEBHOOK_ID=your-sandbox-webhook-id
